<?xml version="1.0" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<CubeBlocks>
		<Definition xsi:type="MyObjectBuilder_MergeBlockDefinition">
			<Id>
				<TypeId>MergeBlock</TypeId>
				<SubtypeId>MonorailMergeBlock</SubtypeId>
			</Id>
			<DisplayName>{LOC:DisplayName_MonorailMergeBlock}</DisplayName>
			<Description>{LOC:Description_MonorailMergeBlock}</Description>
			<Icon>Textures\GUI\Icons\Cubes\MonorailMergeBlock.dds</Icon>
			<CubeSize>Large</CubeSize>
			<BlockTopology>TriangleMesh</BlockTopology>
			<Size x="1" y="1" z="5"/>
			<ModelOffset x="0" y="0" z="0"/>
			<Model>Models\Cubes\large\MonorailMergeBlock.mwm</Model>
			<Components>
				<Component Subtype="SteelPlate" Count="105" />
				<Component Subtype="Construction" Count="15" />
				<Component Subtype="Motor" Count="2" />
				<Component Subtype="LargeTube" Count="6" />
				<Component Subtype="Computer" Count="2" />
				<Component Subtype="SteelPlate" Count="32" />
			</Components>
			<CriticalComponent Subtype="Computer" Index="0" />
			<MountPoints>
				<MountPoint Side="Front" StartX="0.21" StartY="0.21" EndX="0.79" EndY="0.79" Default="true"/>
				<MountPoint Side="Back" StartX="0.14" StartY="0.14" EndX="0.86" EndY="0.86"/>
				<MountPoint Side="Bottom" StartX="0.00" StartY="0.00" EndX="1.00" EndY="5.00"/>
			</MountPoints>
			<BuildProgressModels>
				<Model BuildPercentUpperBound="0.33" File="Models\Cubes\large\MonorailMergeBlock_BS1.mwm"/>
				<Model BuildPercentUpperBound="0.67" File="Models\Cubes\large\MonorailMergeBlock_BS2.mwm"/>
				<Model BuildPercentUpperBound="1.00" File="Models\Cubes\large\MonorailMergeBlock_BS3.mwm"/>
			</BuildProgressModels>
			<BlockPairName>MonorailMergeBlock</BlockPairName>
			<MirroringY>Z</MirroringY>
			<MirroringZ>Y</MirroringZ>
			<Public>true</Public>
			<BuildTimeSeconds>20</BuildTimeSeconds>
			<DamageEffectName>Damage_HeavyMech_Damaged</DamageEffectName>
			<DamagedSound>ParticleHeavyMech</DamagedSound>
			<EmissiveColorPreset>ConnectBlock</EmissiveColorPreset>
			<DestroyEffect>BlockDestroyedExplosion_Large</DestroyEffect>
			<DestroySound>WepSmallWarheadExpl</DestroySound>
			<GeneralDamageMultiplier>0.5</GeneralDamageMultiplier>			<!-- this one is "delicate" makes sense it would take more damage -->
			<DeformationRatio>0.2</DeformationRatio>
			<PCU>100</PCU>
			<IsAirTight>false</IsAirTight>
		</Definition>
	</CubeBlocks>
</Definitions>